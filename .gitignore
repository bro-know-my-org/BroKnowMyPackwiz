# Repository allowlist. Local test fixtures, build outputs, and pack runtime
# files are ignored by default.
/*

# Repo metadata
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/README.md
!/README.en.md
!/TODO.md
!/LICENSE
# Public documentation allowlist. Other docs remain local.
!/docs/
/docs/**
!/docs/README.md
!/docs/architecture.md
!/docs/workflows.md
!/docs/metadata-format.md
!/docs/machine-protocol.md
!/docs/testing.md
!/.github/
!/.github/workflows/
!/.github/workflows/**
!/packages/
!/packages/npm/
!/packages/npm/**
!/packages/npm-platforms/
!/packages/npm-platforms/**

# Rust package
!/Cargo.toml
!/Cargo.lock
!/src/
!/src/**
!/tests/
!/tests/**

# Common local/build outputs, kept here for clarity even though the allowlist
# above already ignores them.
/target/
/.pw/
/_*/
/packages/npm-platforms/**/bkmpw
/packages/npm-platforms/**/bkmpw.exe
*.tgz
*.exe
*.pdb
*.log
*.tmp
